# Copy this file to .env to override local defaults.
# Leave the values empty to use a local PostgreSQL server with your OS user.
# Never commit the copied .env file. Production values belong on Render.
# See the README for the Docker Compose values.

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=

DATABASE_URL=
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# A normal deploy does not need owner settings. The account already exists.
# Local development uses the sample account in the README.
# Set this only to replace a forgotten password, then remove it and deploy again.
# OWNER_NEW_PASSWORD=

# Image storage on Cloudflare R2. Leave these empty on your own machine.
# Development uses a local folder. Real values belong only in Render.
# See docs/DEPLOY_RENDER.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
