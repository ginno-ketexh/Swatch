# Copy this file to .env to override local defaults.
# Leave the values empty to use a local PostgreSQL server with your OS user.
# Never commit the copied .env file. Production values belong on Render.
# See the README for the Docker Compose values.

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=

DATABASE_URL=
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# Used once, by the Render build, to create the first owner account.
# The password must be at least 15 characters. Remove both after you sign in.
# Local development does not need these. The sample account is in the README.
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional. Set this only to replace a forgotten password, then remove it
# and deploy again. Leave it unset the rest of the time.
# OWNER_NEW_PASSWORD=
