# Copy this file to .env to override local defaults.
# Leave the values empty to use a local PostgreSQL server with your OS user.
# Never commit the copied .env file. Production values belong on Render.
# See the README for the Docker Compose values.

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=

DATABASE_URL=
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# Owner login for the temporary lock (until real accounts exist).
# Leave these empty locally to use the development defaults.
# On Render, set both. Do not put the real values in this file.
OWNER_USERNAME=
OWNER_PASSWORD=
