<article class="sheet">
  <h1><%= @link.public_title %></h1>
  <p class="count"><%= pluralize(@page.total, "swatch") %></p>
  <% if @page.items.empty? %>
    <p>Nothing here yet.</p>
  <% else %>
    <ul class="grid">
      <% @page.items.each_with_index do |item, index| %>
        <% color = safe_color(item.color) %>
        <% key = @link.signed_key(item) %>
        <li>
          <a class="card" href="<%= public_share_item_path(@link.token, key) %>">
            <% if item.image.attached? %>
              <% width, height = image_size(item) %>
              <img
                src="<%= public_share_image_path(@link.token, key, "card") %>"
                srcset="<%= public_share_image_path(@link.token, key, "card") %> 400w, <%= public_share_image_path(@link.token, key, "card_2x") %> 800w"
                sizes="(min-width: 40rem) 18rem, 100vw"
                width="<%= width %>"
                height="<%= height %>"
                alt=""
                <% if color %>style="background-color: <%= color %>"<% end %>
                loading="<%= index < 2 ? "eager" : "lazy" %>">
            <% elsif color %>
              <span class="swatch-block" style="background-color: <%= color %>"></span>
            <% end %>
            <span class="card-title"><%= item.title %></span>
          </a>
          <% if color %>
            <p class="colour">
              <span class="chip" style="background-color: <%= color %>"></span>
              <span><%= color %></span>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
    <nav class="pager" aria-label="More swatches">
      <% if @page.show_newer %>
        <% newer_href = @page.newer_after ? public_share_path(@link.token, after: @page.newer_after) : public_share_path(@link.token) %>
        <a href="<%= newer_href %>" aria-label="Newer swatches, page <%= @page.page_number - 1 %>">Newer swatches</a>
      <% end %>
      <% if @page.older_after %>
        <a href="<%= public_share_path(@link.token, after: @page.older_after) %>" aria-label="Older swatches, page <%= @page.page_number + 1 %>">Older swatches</a>
      <% end %>
    </nav>
  <% end %>
</article>
