<div class="mt-4">
  <label class="block" for="<%= id %>"><%= label %></label>
  <div class="mt-1 grid gap-2">
    <input
      id="<%= id %>"
      name="<%= name %>"
      type="password"
      autocomplete="<%= autocomplete %>"
      class="min-h-11 w-full min-w-0 border border-ink bg-canvas px-3 text-ink"
      <% if invalid %>
        aria-invalid="true"
        aria-describedby="<%= describedby %>"
      <% end %>
    >
    <button
      type="button"
      class="min-h-11 justify-self-start underline"
      data-password-toggle
      aria-pressed="false"
      aria-controls="<%= id %>"
    >
      Show password
    </button>
  </div>
</div>
